# Argus environment configuration
# Copy to `.env` and adjust. The defaults below match the bundled Docker Compose
# stack and work out of the box for local development.

# --- Database (PostgreSQL) ---
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus_password
POSTGRES_DB=argus_db
# Full SQLAlchemy URL used by the backend (overrides the parts above when set).
DATABASE_URL=postgresql+asyncpg://argus:argus_password@db:5432/argus_db

# --- Cache (Redis) ---
REDIS_URL=redis://redis:6379/0

# --- Market data / execution provider ---
# CCXT exchange id used for market data and paper-trading execution.
DATA_PROVIDER=okx

# --- Optional: Telegram signal alerts ---
# Leave blank to disable. Create a bot via @BotFather to obtain a token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
