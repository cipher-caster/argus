{
  "model": "claude-sonnet-4-6",
  "outputStyle": "concise",
  "permissions": {
    "allow": [
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(pytest:*)",
      "Bash(git:*)",
      "Read",
      "Write(.claude)",
      "Edit"
    ]
  },
  "env": {
    "PYTEST_TIMEOUT": "300",
    "COMPOSE_PROJECT_NAME": "argus",
    "TEST_ENV": "docker"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-checks.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
